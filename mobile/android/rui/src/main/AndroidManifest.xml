<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <application>
        <!-- RUI draws the whole window itself (raylib, OpenGL ES 2), as a
             NativeActivity running libmain.so. Rotation and resizing are
             handled by RUI's layout, not by restarting the Activity. -->
        <activity
            android:name="dev.rui.android.RuiActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <meta-data android:name="android.app.lib_name" android:value="main" />
        </activity>
    </application>
</manifest>
